# Google Gemini API (Recommended primary provider)
GEMINI_API_KEY=

# OpenAI API Key (Optional secondary / consensus provider)
OPENAI_API_KEY=

# Anthropic Claude API Key (Optional secondary / consensus provider)
ANTHROPIC_API_KEY=

# Central Model Configuration
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-3.7-flash

# Multi-Model Pipeline:
# MODEL_PARSE: Used for structured parsing and information extraction
MODEL_PARSE=gemini-3.6-flash

# MODEL_REASON: Used for 3-tier gap analysis, semantic scoring, and natural rewrites
MODEL_REASON=gemini-3.7-flash

# Optional Dual-Model Consensus check provider (e.g., anthropic or openai)
SECONDARY_AI_PROVIDER=
SECONDARY_AI_MODEL=
